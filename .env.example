# Copie para ".env" e preencha com valores locais. NUNCA faça commit do .env.

# Aplicação
APP_ENV=development
APP_PORT=8080

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=suportetech
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Provedor de identidade (OAuth 2.0 / OIDC)
OIDC_ISSUER_URL=https://seu-provedor.exemplo.com
OIDC_CLIENT_ID=seu_client_id
OIDC_CLIENT_SECRET=seu_client_secret
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback

# API Gateway
RATE_LIMIT_PER_MINUTE=60

# Canais de notificação
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=seu_usuario_smtp
SMTP_PASSWORD=sua_senha_smtp
WHATSAPP_API_TOKEN=seu_token_whatsapp
TELEGRAM_BOT_TOKEN=seu_token_telegram
PUSH_API_KEY=sua_chave_push

# SLA
SLA_ALERT_MINUTES_BEFORE=30
